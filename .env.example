# =========================================================================
# MODELO DE VARIÁVEIS DE AMBIENTE (.env) — CONECTA MAIS (FIREBASE)
# =========================================================================
# 1. Copie este arquivo e renomeie a cópia para ".env" (na raiz do projeto).
# 2. Preencha os 6 valores com as chaves do seu Firebase Console.
# 3. No computador, rode "node scripts/gerar-env.js" para gerar js/firebase-env.js.
# 4. No Vercel, cadastre estas mesmas 6 variáveis em:
#    Project -> Settings -> Environment Variables
# =========================================================================

FIREBASE_API_KEY=COLE_SUA_API_KEY_AQUI
FIREBASE_AUTH_DOMAIN=SEU_PROJETO.firebaseapp.com
FIREBASE_PROJECT_ID=SEU_PROJETO
FIREBASE_STORAGE_BUCKET=SEU_PROJETO.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000
